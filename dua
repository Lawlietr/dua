#!/bin/bash
# dua - Linux disk analysis & system status CLI.
# Router only: parses args and dispatches to the Go binaries.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve a binary next to the router (flat install), under bin/ (repo
# layout), or from PATH. Empty when not found.
resolve_bin() {
    local name="$1"
    if [ -x "$SCRIPT_DIR/$name" ]; then
        printf '%s\n' "$SCRIPT_DIR/$name"
    elif [ -x "$SCRIPT_DIR/bin/$name" ]; then
        printf '%s\n' "$SCRIPT_DIR/bin/$name"
    elif command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
    fi
}

# Dispatch to a binary, forwarding all remaining arguments.
run_bin() {
    local name="$1"
    shift
    local bin
    bin="$(resolve_bin "$name")"
    if [ -z "$bin" ]; then
        echo "dua: $name not found (run 'make build' or install dua to your PATH)" >&2
        exit 1
    fi
    exec "$bin" "$@"
}

# ---------------------------------------------------------------------------
# dua update — check GitHub for a newer release and replace binaries in-place.
# ---------------------------------------------------------------------------

# Print the nearest tag the working tree is based on, or the embedded version.
current_tag() {
    local tag ver
    if [ -d "$SCRIPT_DIR/.git" ] || git rev-parse --git-dir >/dev/null 2>&1; then
        tag="$(git describe --tags --abbrev=0 2>/dev/null)" || true
        if [ -n "$tag" ]; then
            printf '%s\n' "$tag"
            return 0
        fi
    fi
    # Fallback: extract the leading v*.*.* from the embedded version string.
    ver="$(dua version 2>/dev/null | head -1)" || true
    printf '%s' "$ver" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Normalize a version string to "vX.Y.Z" for comparison.
normalize_version() {
    printf '%s' "$1" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Compare two normalized versions. Returns 0 if $1 < $2, 1 if equal, 2 if $1 > $2.
version_cmp() {
    local a b
    a="$(normalize_version "$1")"
    b="$(normalize_version "$2")"
    [ "$a" = "$b" ] && return 1
    # Use sort -V for version-aware ordering.
    local smallest
    smallest="$(printf '%s\n%s\n' "$a" "$b" | sort -V | head -1)"
    [ "$smallest" = "$a" ] && return 0 || return 2
}

# Detect the tarball name for the current platform (OS + architecture).
platform_tarball() {
    local os arch
    os="$(uname -s)"
    arch="$(uname -m)"
    case "$os:$arch" in
        Linux:x86_64)              printf 'dua-linux-amd64' ;;
        Linux:aarch64|Linux:arm64) printf 'dua-linux-arm64' ;;
        Darwin:arm64)              printf 'dua-darwin-arm64' ;;
        *) echo "dua: unsupported platform: $os/$arch" >&2; return 1 ;;
    esac
}

do_update() {
    local latest_tag current ver_url sha_url tarball_name tmpdir tmp_tarball tmp_sha

    # Resolve the install prefix (where the router lives).
    local install_dir
    install_dir="$(cd "$SCRIPT_DIR" && pwd)"

    echo "dua: checking for updates ..."

    # Fetch latest release info from GitHub API.
    local release_json
    release_json="$(curl -fsSL --max-time 10 \
        https://api.github.com/repos/Lawlietr/dua/releases/latest 2>/dev/null)" || {
        echo "dua: failed to fetch release info from GitHub" >&2
        exit 1
    }

    latest_tag="$(printf '%s' "$release_json" | grep -oE '"tag_name":\s*"v[0-9]+\.[0-9]+\.[0-9]+"' \
        | head -1 | sed 's/.*"tag_name":\s*"\(v[0-9]*\.[0-9]*\.[0-9]*\)".*/\1/')"

    if [ -z "$latest_tag" ]; then
        echo "dua: could not parse latest tag from GitHub response" >&2
        exit 1
    fi

    current="$(current_tag)"
    echo "dua: current version  : ${current:-unknown}"
    echo "dua: latest release   : ${latest_tag}"

    # version_cmp: 0 = current < latest (update available),
    #              1 = equal, 2 = current > latest (local is newer).
    local cmp_rc=0
    version_cmp "$current" "$latest_tag" || cmp_rc=$?
    case $cmp_rc in
        1)
            echo "dua: already up to date ($latest_tag)"
            return 0
            ;;
        2)
            echo "dua: local version (${current:-unknown}) is newer than latest release ($latest_tag); skipping update"
            return 0
            ;;
    esac

    tarball_name="$(platform_tarball)"
    ver_url="https://github.com/Lawlietr/dua/releases/download/${latest_tag}/${tarball_name}.tar.gz"
    sha_url="${ver_url}.sha256"

    echo "dua: downloading ${tarball_name}.tar.gz ..."
    tmpdir="$(mktemp -d)"
    tmp_tarball="${tmpdir}/${tarball_name}.tar.gz"
    tmp_sha="${tmpdir}/${tarball_name}.tar.gz.sha256"

    if ! curl -fsSL --max-time 30 -o "$tmp_tarball" "$ver_url"; then
        echo "dua: failed to download ${tarball_name}.tar.gz" >&2
        rm -rf "$tmpdir"
        exit 1
    fi

    echo "dua: downloading ${tarball_name}.tar.gz.sha256 ..."
    if ! curl -fsSL --max-time 10 -o "$tmp_sha" "$sha_url"; then
        echo "dua: failed to download checksum file" >&2
        rm -rf "$tmpdir"
        exit 1
    fi

    echo "dua: verifying checksum ..."
    (cd "$tmpdir" && sha256sum -c "$(basename "$tmp_sha")") || {
        echo "dua: checksum mismatch — aborting" >&2
        rm -rf "$tmpdir"
        exit 1
    }

    echo "dua: extracting ..."
    mkdir -p "${tmpdir}/stage"
    tar -xzf "$tmp_tarball" -C "${tmpdir}/stage"

    # Check write permission on the install directory.
    if [ ! -w "$install_dir" ]; then
        echo "dua: permission denied — cannot write to $install_dir" >&2
        echo "dua: try running with sudo, or install to ~/.local/bin instead" >&2
        rm -rf "$tmpdir"
        exit 1
    fi

    # Back up existing binaries before replacing.
    cp "$install_dir/dua"              "${tmpdir}/stage/dua.bak"              2>/dev/null || true
    cp "$install_dir/dua-analyze"      "${tmpdir}/stage/dua-analyze.bak"      2>/dev/null || true
    cp "$install_dir/dua-status"       "${tmpdir}/stage/dua-status.bak"       2>/dev/null || true

    cp "${tmpdir}/stage/dua"           "$install_dir/dua"
    cp "${tmpdir}/stage/dua-analyze"   "$install_dir/dua-analyze"
    cp "${tmpdir}/stage/dua-status"    "$install_dir/dua-status"

    # Sanity-check the swapped binaries before dropping the backups; on
    # failure restore the previous versions and keep the staging directory
    # around for inspection.
    if ! "$install_dir/dua" version >/dev/null 2>&1; then
        echo "dua: updated binaries failed their sanity check — rolling back" >&2
        [ -f "${tmpdir}/stage/dua.bak" ]         && cp "${tmpdir}/stage/dua.bak"         "$install_dir/dua"
        [ -f "${tmpdir}/stage/dua-analyze.bak" ] && cp "${tmpdir}/stage/dua-analyze.bak" "$install_dir/dua-analyze"
        [ -f "${tmpdir}/stage/dua-status.bak" ]  && cp "${tmpdir}/stage/dua-status.bak"  "$install_dir/dua-status"
        echo "dua: previous binaries restored; staging kept at ${tmpdir} for inspection" >&2
        return 1
    fi

    rm -rf "$tmpdir"

    echo "dua: updated ${current:-unknown} → ${latest_tag}"
    echo "dua: run 'dua version' to confirm"
}

case "${1:-}" in
    "analyze" | "analyse")
        run_bin dua-analyze "${@:2}"
        ;;
    "status")
        run_bin dua-status "${@:2}"
        ;;
    "version")
        run_bin dua-status version
        ;;
    "update")
        do_update
        ;;
    "-h" | "--help" | "")
        cat <<'EOF'
dua - disk analysis and system status for Linux

Usage:
  dua analyze [PATH]   Visual disk explorer (reads only, no cleanup)
  dua status           Live system health dashboard
  dua version           Show version and commit info
  dua update            Check GitHub and update to the latest release
  dua help             Show this help

Run 'dua <command> --help' for command-specific flags.
EOF
        ;;
    "help")
        cat <<'EOF'
dua - disk analysis and system status for Linux

Commands:
  analyze [PATH]   Visual disk explorer. No PATH scans the machine overview.
  status           Live system health dashboard (TUI, --json, --watch).
  version           Show version and commit info.
  update           Check GitHub for a newer release and update in-place.

Run 'dua analyze --help' or 'dua status --help' for command-specific flags.
EOF
        ;;

    *)
        echo "dua: unknown command '$1'" >&2
        echo "Run 'dua help' for usage." >&2
        exit 1
        ;;
esac
